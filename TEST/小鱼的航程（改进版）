#include <stdio.h>
int main()
{
    int x, n;
    int sum = 0;
    scanf("%d %d", &x, &n);
    for (; n > 0; n--)
    {
        if (x >= 1 && x <= 5)
        {
            sum += 250;
            x++;
        }
        else if (x == 6)
        {
            x++;
        }
        else
        {
            x = 1;
        }
    }
    printf("%d", sum);

    return 0;
}
